        { "text": "Вставьте слово: 'Where ___ my suitcase?'", "type": "FillInTheBlank", "options": "is|are|am|be", "correctAnswer": "is" },
        { "text": "Как переводится 'Arrivals'?", "type": "MultipleChoice", "options": "Прибытие|Вылет|Таможня|Справка", "correctAnswer": "Прибытие" },
        { "text": "Переведите: 'I have a reservation'", "type": "MultipleChoice", "options": "У меня есть бронь|Я хочу заказать|Где отель?|Мне нужен номер", "correctAnswer": "У меня есть бронь" },
        { "text": "Выберите верное: 'A ___ for two nights'", "type": "WordChoice", "options": "room|car|table|ticket", "correctAnswer": "room" },
        { "text": "Как сказать 'Посадочный талон'?", "type": "MultipleChoice", "options": "Boarding pass|Credit card|Passport|Map", "correctAnswer": "Boarding pass" }
