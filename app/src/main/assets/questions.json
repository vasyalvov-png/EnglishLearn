{
  "lessons": [
    {
      "title": "Основы 1: Приветствия",
      "description": "Выучите базовые английские приветствия",
      "difficultyLevel": "Легко",
      "type": "Intro",
      "theoryText": "В английском языке приветствия зависят от времени суток.\n• Hello / Hi — универсальные.\n• Good morning — до 12:00.\n• Good afternoon — после 12:00.\n• Good evening — вечером.",
      "questions": [
        { "text": "Как переводится 'Hello'?", "type": "MultipleChoice", "options": "Привет|Пока|Спасибо|Пожалуйста", "correctAnswer": "Привет" },
        { "text": "Переведите: 'Good morning'", "type": "MultipleChoice", "options": "Добрый вечер|Доброе утро|Привет|Как дела", "correctAnswer": "Доброе утро" },
        { "text": "Вставьте слово: 'I ___ a teacher'", "type": "FillInTheBlank", "options": "am|is|are|be", "correctAnswer": "am" },
        { "text": "Как сказать 'Добрый вечер'?", "type": "MultipleChoice", "options": "Good evening|Good morning|Good night|Hi", "correctAnswer": "Good evening" },
        { "text": "Переведите: 'See you later'", "type": "MultipleChoice", "options": "Увидимся позже|Здравствуйте|Удачи|Помогите", "correctAnswer": "Увидимся позже" },
        { "text": "Как ответить на 'How are you?'", "type": "MultipleChoice", "options": "I am fine|I am teacher|Good night|Nice", "correctAnswer": "I am fine" },
        { "text": "Вставьте пропуск: 'Hi, how ___ you?'", "type": "FillInTheBlank", "options": "are|is|am|be", "correctAnswer": "are" },
        { "text": "Как сказать 'До свидания'?", "type": "MultipleChoice", "options": "Goodbye|Please|Welcome|Sorry", "correctAnswer": "Goodbye" },
        { "text": "Переведите: 'Nice to meet you'", "type": "MultipleChoice", "options": "Приятно познакомиться|Как дела|Добрый день|Пока", "correctAnswer": "Приятно познакомиться" },
        { "text": "Выберите верное: 'Good ___, sir' (днем)", "type": "WordChoice", "options": "afternoon|morning|night|evening", "correctAnswer": "afternoon" }
      ]
    },
